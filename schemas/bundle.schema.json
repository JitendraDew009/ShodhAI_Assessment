{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bundle.schema.json",
  "title": "Workflow review bundle",
  "type": "object",
  "required": ["review_revision", "field_units", "source", "specification", "workflow", "snippet"],
  "properties": {
    "review_revision": {"type": "string"},
    "field_units": {"type": "object", "additionalProperties": {"enum": ["seconds", "minutes", "hours"]}},
    "source": {"$ref": "#/$defs/anchoredSource"},
    "specification": {"$ref": "#/$defs/specification"},
    "workflow": {"$ref": "#/$defs/workflow"},
    "snippet": {"$ref": "#/$defs/snippet"},
    "approval_records": {"type": "array", "items": {"$ref": "#/$defs/approval"}}
  },
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "anyOf": [
        {"type": "object", "required": ["all"], "properties": {"all": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}, "additionalProperties": false},
        {"type": "object", "required": ["any"], "properties": {"any": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/condition"}}}, "additionalProperties": false},
        {"type": "object", "required": ["not"], "properties": {"not": {"$ref": "#/$defs/condition"}}, "additionalProperties": false},
        {"type": "object", "required": ["field", "op"], "properties": {
          "field": {"type": "string", "minLength": 1},
          "op": {"enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "missing", "present"]},
          "value": {}
        }, "additionalProperties": false},
        {"type": "object", "minProperties": 1}
      ]
    },
    "decisionNode": {
      "type": "object",
      "required": ["id", "type", "when"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_ref": {"type": "string"},
        "type": {"const": "decision"},
        "when": {"$ref": "#/$defs/condition"},
        "then": {"type": "string", "minLength": 1},
        "else": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "routeNode": {
      "type": "object",
      "required": ["id", "type", "route"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "rule_ref": {"type": "string"},
        "type": {"const": "route"},
        "route": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "versioned": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "requirement": {
      "type": "object",
      "required": ["id", "anchor", "source_text", "when", "route"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "anchor": {"type": "string", "minLength": 1},
        "source_text": {"type": "string", "minLength": 1},
        "precedence": {"type": "integer"},
        "when": {"$ref": "#/$defs/condition"},
        "route": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "anchoredSource": {
      "allOf": [
        {"$ref": "#/$defs/versioned"},
        {"type": "object", "required": ["requirements"], "properties": {
          "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}
        }}
      ],
      "unevaluatedProperties": false
    },
    "specification": {
      "allOf": [
        {"$ref": "#/$defs/versioned"},
        {"type": "object", "required": ["rules"], "properties": {
          "rules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/requirement"}}
        }}
      ],
      "unevaluatedProperties": false
    },
    "workflow": {
      "allOf": [
        {"$ref": "#/$defs/versioned"},
        {"type": "object", "required": ["start", "nodes"], "properties": {
          "start": {"type": "string"},
          "nodes": {"type": "array", "minItems": 1, "items": {"oneOf": [
            {"$ref": "#/$defs/decisionNode"},
            {"$ref": "#/$defs/routeNode"}
          ]}}
        }}
      ],
      "unevaluatedProperties": false
    },
    "snippet": {
      "allOf": [
        {"$ref": "#/$defs/versioned"},
        {"type": "object", "required": ["source"], "properties": {"source": {"type": "string"}}}
      ],
      "unevaluatedProperties": false
    },
    "approval": {
      "type": "object",
      "required": ["change_id", "revision", "sequence", "target_rule", "status"],
      "properties": {
        "change_id": {"type": "string"},
        "revision": {"type": "string"},
        "sequence": {"type": "integer", "minimum": 0},
        "target_rule": {"type": "string"},
        "status": {"enum": ["approved", "unapproved"]},
        "replacement": {"type": "object", "properties": {
          "when": {"$ref": "#/$defs/condition"},
          "route": {"type": "string"}
        }, "minProperties": 1, "additionalProperties": false}
      },
      "additionalProperties": false
    }
  }
}
